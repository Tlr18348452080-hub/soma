{
  "name": "dsh-soma",
  "version": "0.1.0",
  "description": "给 AI 一副会自己演化的身体：触觉、温度、疲劳、饥饿全走生理与物理方程",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "身体",
    "触觉",
    "生理"
  ]
}